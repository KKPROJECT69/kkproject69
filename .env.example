# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional: Telegram-only proxy (e.g. socks5://user:pass@host:port or http://host:port)
TELEGRAM_PROXY=
# Optional: market-data proxy (kept independent from Telegram route)
MARKET_PROXY=

# ===== Market Data =====
# novex | oanda | cortex | mock
MARKET_SOURCE=mock
NOVEX_BASE_URL=
NOVEX_API_KEY=

# ===== News Calendar =====
FOREX_FACTORY_URL=

# ===== AI Reasoning / Approval =====
# Leave empty to use the built-in rule-based (offline) AI layer
AI_API_URL=
AI_API_KEY=

# ===== Signal / Safety Gates =====
MIN_CONFIDENCE=70
MIN_PAYOUT=0
SIGNAL_LEAD_SECONDS=17

# ===== Storage / Ops =====
DB_PATH=data/hacker.db
LOG_LEVEL=INFO

# Comma-separated Telegram user IDs with ADMIN access
ADMIN_IDS=
