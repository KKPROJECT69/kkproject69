# ===== Telegram =====
TELEGRAM_BOT_TOKEN=8983290716:AAF96S1P7Y1I3H0KDJ3j123fZoclyb3dvGk
TELEGRAM_CHANNEL_ID=-1003958046134
# Optional: Telegram-only proxy (e.g. socks5://user:pass@host:port or http://host:port)
TELEGRAM_PROXY=
# Optional: market-data proxy (kept independent from Telegram route)
MARKET_PROXY=

# ===== Market Data =====
# auto (router: OTC->Quotex, forex->OANDA, payout->NovexAI) | mock
MARKET_SOURCE=auto

# Quotex live tick proxy (OTC candles, no payout)
QUOTEX_BASE_URL=https://quotex-proxy-pal.lovable.app/api/public
QUOTEX_WS_URL=wss://quotex-proxy-pal.lovable.app/api/public/ws

# NovexAI payout endpoint
NOVEX_PAYOUT_URL=https://novexai.org/api.php

# OANDA live pairs data (practice)
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# ===== News Calendar =====
FOREX_FACTORY_URL=

# ===== AI Reasoning / Approval (100% free options) =====
# local = built-in rule-based AI (no key, no network, zero error)
# gemini = Google Gemini FREE tier  |  groq = Groq FREE tier
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Signal / Safety Gates =====
MIN_CONFIDENCE=70
MIN_PAYOUT=0
SIGNAL_LEAD_SECONDS=17

# ===== Storage / Ops =====
DB_PATH=data/hacker.db
LOG_LEVEL=INFO

# Comma-separated Telegram user IDs with ADMIN access
ADMIN_IDS=

# ===== Web Dashboard / Admin Panel =====
# Railway injects PORT automatically; set WEB_PORT only when running locally.
PORT=8000
WEB_HOST=0.0.0.0
# Admin login for the web control panel. If empty, the admin panel is DISABLED.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=$
WEB_COOKIE_NAME=hacker_admin
WEB_SESSION_TTL_HOURS=24

# Send "deployed & online" notice to the Telegram channel on startup.
DEPLOY_NOTIFY=true
